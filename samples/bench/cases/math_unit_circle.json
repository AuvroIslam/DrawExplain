    "sin\\w*[^.\\n]{0,40}150[^.\\n]{0,80}(?:=|is|equals|gives|comes out(?: to)?|get)\\s*(?:exactly\\s*)?(?:positive\\s*)?(?:\\+\\s*)?(?:1\\s*/\\s*2|0[.,]5|one[- ]half|a half)(?![\\d/]|[.,]\\d)",
    "sin\\w*\\s*\\(?\\s*5\\s*π\\s*/\\s*6\\s*\\)?\\s*=\\s*1\\s*/\\s*2"
   ],
   "min_any": 1
  },
  {
   "name": "y_coordinate",
   "description": "Explains that the sine is the y-coordinate (height) of the point on the unit circle.",
